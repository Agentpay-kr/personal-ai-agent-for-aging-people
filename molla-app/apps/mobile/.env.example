# Optional public server address prefill. No automatic demo fallback.
# Never put a model key, Phone Harness key or owner token in EXPO_PUBLIC variables.
# Enter the owner-specific app token on the connection screen (native SecureStore).
# EXPO_PUBLIC_API_URL=https://your-authenticated-molla-server.example

# Development only: adb reverse tcp:4318 tcp:4318 for Android USB.
# Release builds require HTTPS by default. This opt-in allows loopback/emulator HTTP
# for local verification only; it does not permit arbitrary LAN/public HTTP hosts.
# EXPO_PUBLIC_ALLOW_LOCAL_API=1
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4318
