{
  "name": "molla-family-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "agent": "eve dev",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0", "eve": "latest", "ai": "latest", "zod": "^4.0.0" },
  "devDependencies": { "vite": "latest", "@vitejs/plugin-react": "latest", "typescript": "latest", "@types/react": "latest", "@types/react-dom": "latest", "@types/node": "latest", "@playwright/test": "latest" }
}
