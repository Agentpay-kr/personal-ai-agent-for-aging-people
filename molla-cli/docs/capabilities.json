{
  "name": "molla",
  "version": "0.2.0",
  "schema_version": "1.0",
  "transport": "direct-process-sqlite",
  "http_server_required": false,
  "browser_required": false,
  "production_auth": false,
  "operations": [
    {
      "name": "health",
      "arguments": {},
      "read_only": true,
      "requires_session": false
    },
    {
      "name": "identity.get",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "family.list",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "family.invite",
      "arguments": {
        "name": {
          "type": "string",
          "required": true,
          "max": 20
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "family.join",
      "arguments": {
        "code": {
          "type": "string",
          "required": true,
          "max": 8
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "task.create",
      "arguments": {
        "text": {
          "type": "string",
          "required": true,
          "max": 1000
        },
        "owner": {
          "type": "string",
          "required": false,
          "max": 100
        },
        "draft": {
          "type": "string",
          "required": false,
          "max": 1000
        },
        "contactId": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "task.list",
      "arguments": {
        "status": {
          "type": "string",
          "required": false,
          "values": [
            "awaiting_approval",
            "running",
            "prepared",
            "needs_verification",
            "failed",
            "completed",
            "rejected",
            "cancelled"
          ]
        }
      },
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "task.get",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "task.decide",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "decision": {
          "type": "string",
          "required": true,
          "values": [
            "approve",
            "reject",
            "cancel"
          ]
        },
        "ownerConfirmed": {
          "type": "boolean",
          "required": false
        },
        "expectedActionHash": {
          "type": "string",
          "required": false,
          "max": 64
        },
        "ownerToken": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "task.execute",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "task.recover",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "memory.list",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "memory.search",
      "arguments": {
        "query": {
          "type": "string",
          "required": false,
          "max": 300
        }
      },
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "memory.remember",
      "arguments": {
        "text": {
          "type": "string",
          "required": true,
          "max": 300
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "memory.correct",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "text": {
          "type": "string",
          "required": true,
          "max": 300
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "memory.forget",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "memory.shared",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "memory.share",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "grantee": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "ownerToken": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "memory.revoke",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "grantee": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "contact.list",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "contact.add",
      "arguments": {
        "name": {
          "type": "string",
          "required": true,
          "max": 40
        },
        "relation": {
          "type": "string",
          "required": true,
          "max": 20
        },
        "phone": {
          "type": "string",
          "required": true,
          "max": 24
        },
        "ownerToken": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "contact.remove",
      "arguments": {
        "id": {
          "type": "string",
          "required": true,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "ontology.get",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "vm.diagnose",
      "arguments": {},
      "read_only": true,
      "requires_session": true
    },
    {
      "name": "vm.compose.plan",
      "arguments": {
        "contactId": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "draft": {
          "type": "string",
          "required": true,
          "max": 1000
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "vm.app.plan",
      "arguments": {
        "appId": {
          "type": "string",
          "required": true,
          "values": [
            "settings",
            "browser",
            "kakao",
            "coupang",
            "calendar"
          ]
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "consent.set",
      "arguments": {
        "value": {
          "type": "string",
          "required": true,
          "values": [
            "active",
            "revoked"
          ]
        },
        "ownerConfirmed": {
          "type": "boolean",
          "required": true
        },
        "ownerToken": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    },
    {
      "name": "permission.set",
      "arguments": {
        "scopes": {
          "type": "string",
          "required": true,
          "max": 100
        },
        "ownerConfirmed": {
          "type": "boolean",
          "required": true
        },
        "ownerToken": {
          "type": "string",
          "required": false,
          "max": 100
        }
      },
      "read_only": false,
      "requires_session": true
    }
  ],
  "approval": {
    "atomic_action_hash_check": true,
    "explicit_execute_command": true,
    "owner_proof_required": [
      "task.decide(approve)",
      "consent.set(active)",
      "permission.set",
      "memory.share",
      "contact.add"
    ],
    "owner_proof_channels": [
      "interactive-terminal-code",
      "owner-token(MOLLA_OWNER_KEY, host app only)"
    ]
  },
  "vm": {
    "per_owner": true,
    "driver": "adb-cli",
    "automatic_sending": false
  }
}
